default_platform(:ios)

platform :ios do

  desc "Sync certificates and profiles using Match"
  lane :sync_certs do
    api_key = get_asc_api_key

    match(
      type: "appstore",
      readonly: ENV["MATCH_READONLY"] == "true",
      git_url: ENV["MATCH_GIT_URL"],
      app_identifier: "com.ovasta.sellers",
      team_id: "H8X427WWQW",
      api_key: api_key
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Sync signing
    sync_certs

    api_key = get_asc_api_key

    # Update build number
    build_number = Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj: "iosApp.xcodeproj"
    )

    # Build the app
    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "OvastaSellers.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.ovasta.sellers" => "match AppStore com.ovasta.sellers"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  # Helper to build the API key hash
  # Uses key_content (string) instead of key_filepath to avoid OpenSSL 3.x "invalid curve name" bug
  def get_asc_api_key
    require 'base64'

    key_content = Base64.decode64(ENV["ASC_PRIVATE_KEY"])

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: key_content,
      in_house: false
    )
  end

end
