default_platform(:ios)

platform :ios do

  desc "Sync certificates and profiles using Match"
  lane :sync_certs do
    api_key = get_asc_api_key

    match(
      type: "appstore",
      readonly: ENV["MATCH_READONLY"] == "true",
      git_url: ENV["MATCH_GIT_URL"],
      app_identifier: "com.ovasta.sellers",
      team_id: "H8X427WWQW",
      api_key: api_key,

      keychain_name: "build.keychain",
      keychain_password: "actions",

      force: true,
      force_for_new_devices: true
    )

    # 🔥 Debug step (VERY IMPORTANT)
    sh("security find-identity -v -p codesigning")
  end


  desc "Build and upload to TestFlight"
  lane :beta do
    sync_certs

    api_key = get_asc_api_key

    build_number = Time.now.strftime("%Y%m%d%H%M")

    increment_build_number(
      build_number: build_number,
      xcodeproj: "iosApp.xcodeproj"
    )

    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "OvastaSellers.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.ovasta.sellers" => "match AppStore com.ovasta.sellers"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end


  # Helper to build the API key hash
  def get_asc_api_key
    require 'base64'
    require 'openssl'

    key_value = ENV["ASC_PRIVATE_KEY"].to_s.strip
    UI.user_error!("ASC_PRIVATE_KEY is missing") if key_value.empty?

    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]

    UI.user_error!("ASC_KEY_ID is missing") if key_id.to_s.strip.empty?
    UI.user_error!("ASC_ISSUER_ID is missing") if issuer_id.to_s.strip.empty?

    # Handle base64 or raw PEM
    unless key_value.include?("BEGIN PRIVATE KEY") || key_value.include?("BEGIN EC PRIVATE KEY")
      key_value = Base64.decode64(key_value)
    end

    key_value = key_value.gsub('\\n', "\n").gsub("\r\n", "\n").strip

    begin
      parsed_key = OpenSSL::PKey.read(key_value)
    rescue OpenSSL::PKey::PKeyError, OpenSSL::PKey::ECError => e
      UI.user_error!("ASC_PRIVATE_KEY is invalid: #{e.message}")
    end

    UI.user_error!("ASC_PRIVATE_KEY must be EC (.p8)") unless parsed_key.is_a?(OpenSSL::PKey::EC)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: parsed_key.to_pem,
      in_house: false
    )
  end

end