default_platform(:ios)

platform :ios do

  desc "Sync certificates and profiles using Match"
  lane :sync_certs do
    match(
      type: "appstore",
      readonly: is_ci,
      git_url: ENV["MATCH_GIT_URL"],
      app_identifier: "com.ovasta.sellers",
      team_id: "H8X427WWQW"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Sync signing
    sync_certs

    # Update build number
    build_number = Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_number,
      xcodeproj: "iosApp.xcodeproj"
    )

    # Build the app
    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "OvastaSellers.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.ovasta.sellers" => ENV["sigh_com.ovasta.sellers_appstore_profile-name"] || "match AppStore com.ovasta.sellers"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: app_store_connect_api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "App Store Connect API Key"
  private_lane :app_store_connect_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
  end

end
